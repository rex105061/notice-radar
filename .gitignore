# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 虚拟环境
.venv/
venv/
env/

# 敏感配置：绝不入库
.env
.env.local
.streamlit/secrets.toml

# 本地数据（体积大 / 可重新抓取）
data/*.db
# 例外：主库要跟着代码走（约 4MB）。云端部署没有它就打不开页面。
!data/notices.db
data/*.sqlite
data/*.sqlite3
data/*.pdf
data/*.csv
data/*.json
!data/.gitkeep

# 日志与编辑器
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
